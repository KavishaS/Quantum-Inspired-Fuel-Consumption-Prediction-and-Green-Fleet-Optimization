# Copy to .env and adjust. Never commit a real .env.
DATABASE_URL=sqlite:///../data/greenfleet.db
# PostgreSQL: postgresql+psycopg://user:password@localhost:5432/greenfleet
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_START=1
LOG_LEVEL=INFO

# ── AIS Live Tracking (Stage 2) ───────────────────────────────────────────────
# Get a free API key at https://aisstream.io
AISSTREAM_API_KEY=
# Optional: JSON array of [[lat_min,lon_min],[lat_max,lon_max]] bounding boxes
# Defaults to global coverage. Keep small to reduce message volume.
# Example: [[[-10,-10],[10,10]]]
AIS_BOUNDING_BOXES=
# Optional: comma-separated MMSI numbers to filter
AIS_MMSI_FILTERS=
# AIS position history retention in hours (default: 24)
AIS_HISTORY_RETENTION_HOURS=24
# Seconds before a position is considered stale (default: 300 = 5 min)
AIS_STALE_THRESHOLD_SECONDS=300
# Maximum simultaneous frontend WebSocket clients (default: 50)
AIS_MAX_FRONTEND_CLIENTS=50

# ── Marine Weather (Stage 4) ──────────────────────────────────────────────────
# Open-Meteo is free and does not require an API key (usage limits apply)
# See: https://open-meteo.com/en/docs/marine-weather-api
OPEN_METEO_CACHE_SECONDS=300

# ── Quantum Experiments (Stage 6–7) ──────────────────────────────────────────
# Optional: D-Wave Leap quantum annealing
# Get access at https://cloud.dwavesys.com/
DWAVE_API_TOKEN=
DWAVE_SOLVER=

# ── Reporting ─────────────────────────────────────────────────────────────────
# Directory where PDF reports are saved (default: auto-detected)
REPORTS_DIR=
